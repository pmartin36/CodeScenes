<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- This dll is never NuGet-published as an analyzer package; it ships via the editor's
         <Analyzer> csproj injection (b5-t3/b5-t2). RS2008 (release-tracking file requirement) does
         not apply. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SceneBuilder.Grammar/SceneBuilder.Grammar.csproj" />
  </ItemGroup>

  <!-- Stage the freshly-built analyzer assembly into the Unity package's Analyzers~ folder on every
       build. The `~` suffix keeps Unity's importer from touching it; the editor's <Analyzer> csproj
       injection (b5-t2) points the donor project at this staged dll. Mirrors Core.csproj's
       StageCoreDllToUnityPlugins target. -->
  <Target Name="StageAnalyzerDllToUnityAnalyzers" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(MSBuildProjectDirectory)/../com.codescenes/Analyzers~/CodeScenes.Analyzers.dll"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
  </Target>

</Project>

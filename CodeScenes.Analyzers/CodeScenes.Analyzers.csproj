<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- This dll is never NuGet-published as an analyzer package; it ships via the editor's
         <Analyzer> csproj injection (b5-t3/b5-t2). RS2008 (release-tracking file requirement) does
         not apply. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SceneBuilder.Grammar/SceneBuilder.Grammar.csproj" />
  </ItemGroup>

</Project>
